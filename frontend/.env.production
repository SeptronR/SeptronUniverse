# Production build (universe-web image, served at https://app.universe.septronr.com behind Traefik).
# No secrets here — every value is public in the bundle. The API, /ws and /uploads are same-origin (Traefik path routing).
VITE_API_URL=/api/v1
VITE_WS_URL=
VITE_APP_ENV=production
VITE_CAPTCHA_PROVIDER=none
VITE_CAPTCHA_SITE_KEY=
# public half of the server's VAPID pair (python scripts/gen_vapid.py); web push stays off while empty
VITE_VAPID_PUBLIC_KEY=
