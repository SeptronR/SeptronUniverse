# Application
APP_NAME=SeptronUniverse
APP_ENV=development                 # development | demo | production
SECRET_KEY=change-me-64-hex
JWT_KID=k1
JWT_PREVIOUS_KEYS={}                # {"k0":"old-secret"} during rotation
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:5173"]
PLATFORM_HOSTS=["localhost","universe.septronr.com"]
READ_ONLY_MODE=false
# Database (app role is NOT BYPASSRLS; platform role for cross-tenant super-admin queries)
DATABASE_URL=postgresql+asyncpg://universe_app:pass@localhost:5432/universe
PLATFORM_DATABASE_URL=postgresql+asyncpg://universe_platform:pass@localhost:5432/universe
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Redis (required)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Storage
STORAGE_BACKEND=local               # local | s3
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_MB=25
FILE_MIME_SNIFFER=builtin          # builtin | magic (python-magic needs libmagic - set magic in Docker/Linux)
# Optional clamd host (INSTREAM scan on upload); leave empty to skip scanning
CLAMAV_HOST=
CLAMAV_PORT=3310
JOB_RETENTION_DAYS=7
# Integrations (per-tenant overrides live in integration_connections; these are platform defaults / sandbox)
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
PUSH_PROVIDER=mock
PAYMENT_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@universe.local
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_WA_TOKEN=
META_WA_PHONE_ID=
META_APP_SECRET=
FCM_CREDENTIALS_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=
INTEGRATION_ENCRYPTION_KEY=base64-32-bytes
# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
# Platform bootstrap
INSTALL_SECRET_KEY=change-me
SUPERADMIN_EMAIL=superadmin@universe.local
