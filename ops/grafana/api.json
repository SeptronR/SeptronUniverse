{
 "uid": "universe-api",
 "title": "Universe \u2014 API by route",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "p95 by route",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "topk(15, histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[10m]))))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Errors by route",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "topk(15, sum by (handler) (rate(http_requests_total{status=~\"5..\"}[10m])))",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "universe"
 ]
}
