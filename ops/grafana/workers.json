{
 "uid": "universe-workers",
 "title": "Universe \u2014 Celery, outbox & DLQ",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Queue depth",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "max by (queue) (queue_depth)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Workers alive",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "min by (queue) (worker_alive)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Outbox pending / lag",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "max(outbox_pending)",
     "refId": "A"
    },
    {
     "expr": "max(outbox_lag_seconds)",
     "refId": "B"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Dead letters",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "max by (kind) (dlq_size)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Jobs running",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (type) (jobs_running)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Webhook failure ratio",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "max(webhook_failure_ratio)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  }
 ],
 "tags": [
  "universe"
 ]
}
